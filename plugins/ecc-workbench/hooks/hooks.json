{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(process.env.PLUGIN_ROOT,'scripts','lifecycle.cjs'))\"",
            "timeout": 3,
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Read|read_file|file_read|readfile|Bash|bash|shell|powershell|PowerShell|command|terminal|mcp__.*__(?:read|read_file|read_text_file|read_multiple_files|get_file|get_content))$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=process.env.PLUGIN_ROOT||process.env.CODEX_PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT||process.env.ECC_PLUGIN_ROOT;if(p)require(require('path').join(p,'vendor','scripts','hooks','read-routing-gate.cjs'))\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
